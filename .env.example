# Database — optional. Without this set, the app runs entirely on the
# bundled mock dataset (16 demo tracks) — nothing breaks, nothing else to
# configure. Set it to connect the real catalog: run `npm run db:push` then
# `npm run db:seed` once it's set.
DATABASE_URL="postgresql://user:password@localhost:5432/rsync"

# Clerk Authentication — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup
# From Clerk Dashboard → Webhooks → your endpoint's signing secret.
# Only needed if you wire up /api/webhooks/clerk (see Milestone 9 in README).
CLERK_WEBHOOK_SECRET=

# UploadThing — https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# AI recommendation provider (Anthropic, OpenAI, etc.)
AI_API_KEY=
